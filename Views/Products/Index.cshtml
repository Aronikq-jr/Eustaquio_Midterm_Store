@model List<Eustaquio_Midterm_Store.Models.Product>

@{ ViewData["Title"] = "Products"; }



<h1>Products</h1>

<a asp-action="Create" class="btn btn-primary mb-3">+ Add Product</a>

<form asp-action="Index" method="get" class="mb-3">
    <input type="text" name="searchString" value="@ViewData["searchString"]"
       placeholder="Search product name..." />
    <button type="submit">Search</button>
    <a asp-action="Index">Clear</a>
</form> 

<div class="row row-cols-1 g-3 mb-5">
    @foreach (var p in Model)
    {
        <div class="col">
            <div class="card text-center">
                <div class="card-header">
                    <h5 class="card-title mb-0">@p.Name</h5>
                </div>
                <div class="card-body">
                    <span class="badge bg-secondary mb-2">@p.Category</span>
                    <p class="card-text">@p.Description</p>
                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="AddCart" asp-route-id="@p.Id" class="btn btn-sm btn-primary">Add to Cart</a>
                    <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-danger"
                       onclick="return confirm('Delete this product?')">Delete</a>
                </div>
                <div class="card-footer text-body-secondary">
                    @p.Price.ToString("C", new System.Globalization.CultureInfo("en-PH"))
                </div>
            </div>
        </div>
    }
</div>